{
  "name": "block-time",
  "version": "2.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "description": "One click from a task to a calendar block: Linear issues and Reclaim tasks become prefilled Google Calendar events, with an energy-change badge and a weekly Obsidian report",
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test:py": "python3 -m unittest discover -s tools -p 'test_*.py'",
    "verify": "npm run check && npm test && npm run test:py && npm run build"
  },
  "keywords": [
    "userscript",
    "tampermonkey",
    "linear",
    "reclaim",
    "google-calendar"
  ],
  "author": "Ihor Khavkin",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.5",
    "@types/tampermonkey": "^5.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ikhavkin/block-time.git"
  }
}
